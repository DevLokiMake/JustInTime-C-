<UserControl x:Class="JustInTime.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Плавное появление страницы -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.25" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,16">

            <!-- Заголовок и кнопки -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Dashboard" Style="{StaticResource H1}" />
                    <TextBlock Text="Сводка по запланированным действиям" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Обновить"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" />
                    <Button Content="Создать задачу"
                            Command="{Binding CreateTaskCommand}"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>

            <!-- Ошибка загрузки -->
            <Border Style="{StaticResource Banner}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Сводные карточки -->
            <WrapPanel Orientation="Horizontal">
                <Border Style="{StaticResource Card}" Width="260">
                    <StackPanel>
                        <TextBlock Text="Активные задачи" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding ActiveTasks}" Style="{StaticResource CardValue}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Width="260">
                    <StackPanel>
                        <TextBlock Text="Ближайшая задача" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding NextTaskTitle}"
                                   Style="{StaticResource H2}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="{Binding NextTaskTime}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Width="260">
                    <StackPanel>
                        <TextBlock Text="Задачи с ошибкой" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding FailedTasks}" Style="{StaticResource CardValue}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Списки -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Последние действия" Style="{StaticResource H2}" Margin="0,0,0,12" />

                        <TextBlock Text="Пока ничего не выполнялось"
                                   Style="{StaticResource Muted}"
                                   Visibility="{Binding IsRecentEmpty, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl ItemsSource="{Binding RecentActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Последние ошибки" Style="{StaticResource H2}" Margin="0,0,0,12" />

                        <TextBlock Text="Ошибок нет"
                                   Style="{StaticResource Muted}"
                                   Visibility="{Binding IsErrorsEmpty, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl ItemsSource="{Binding RecentErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding ErrorText}"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
