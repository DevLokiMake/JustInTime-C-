<UserControl x:Class="JustInTime.App.Views.MyTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.25" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,16">

            <!-- Заголовок и кнопки -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="My Tasks" Style="{StaticResource H1}" />
                    <TextBlock Text="Ваши запланированные действия" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Обновить"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" />
                    <Button Content="Создать задачу"
                            Command="{Binding CreateTaskCommand}"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>

            <!-- Фильтр -->
            <ListBox Style="{StaticResource ChipList}"
                     Margin="0,0,0,8"
                     ItemsSource="{Binding Filters}"
                     SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                     DisplayMemberPath="Title" />

            <!-- Ошибка -->
            <Border Style="{StaticResource Banner}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Пустой список -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Здесь пока нет задач. Нажмите «Создать задачу», чтобы добавить первую."
                           Style="{StaticResource Muted}" />
            </Border>

            <!-- Задачи -->
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Title}"
                                               Style="{StaticResource H2}"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding StatusText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="12,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Text="{Binding ActionName}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Summary}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
                                    <Run Text="{Binding WhenText, Mode=OneWay}" />
                                    <Run Text="{Binding AttemptsText, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Text="{Binding ErrorText}"
                                           Foreground="{StaticResource DangerBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Изменить"
                                            Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Повторить"
                                            Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Отменить"
                                            Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                                </WrapPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
