<UserControl x:Class="JustInTime.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:JustInTime.App.Localization">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.25" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,16" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="{loc:T page_settings}" Style="{StaticResource H1}" />
            <TextBlock Text="{loc:T set_subtitle}"
                       Style="{StaticResource Muted}" Margin="0,2,0,16" TextWrapping="Wrap" />

            <Border Style="{StaticResource Banner}"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <StackPanel IsEnabled="{Binding IsLoaded}">

                <!-- Язык -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:T set_language_title}" Style="{StaticResource H2}" />
                        <ListBox Style="{StaticResource ChipList}"
                                 ItemsSource="{Binding LanguageOptions}"
                                 SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                 DisplayMemberPath="Title"
                                 Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{loc:T set_language_hint}" />
                    </StackPanel>
                </Border>

                <!-- Автоматизация -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:T set_auto_title}" Style="{StaticResource H2}" />
                        <CheckBox Content="{loc:T set_auto_enabled}"
                                  IsChecked="{Binding AutomationEnabled, Mode=TwoWay}"
                                  Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{loc:T set_auto_hint}" />

                        <TextBlock Text="{loc:T set_grace_label}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <TextBox Text="{Binding GraceMinutesText, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{loc:T set_grace_hint}" />
                    </StackPanel>
                </Border>

                <!-- Уведомления -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:T set_notify_title}" Style="{StaticResource H2}" />
                        <CheckBox Content="{loc:T set_notify_enabled}"
                                  IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}"
                                  Margin="0,12,0,0" />
                        <CheckBox Content="{loc:T set_notify_success}"
                                  IsChecked="{Binding NotifyOnSuccess, Mode=TwoWay}"
                                  Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{loc:T set_notify_hint}" />
                    </StackPanel>
                </Border>

                <!-- Трей и автозапуск -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:T set_tray_title}" Style="{StaticResource H2}" />
                        <CheckBox Content="{loc:T set_tray_enabled}"
                                  IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                  Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{loc:T set_tray_hint}" />

                        <CheckBox Content="{loc:T set_autostart}"
                                  IsChecked="{Binding AutostartEnabled, Mode=TwoWay}"
                                  Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{loc:T set_autostart_hint}" />
                        <TextBlock Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{Binding AutostartNote}"
                                   Visibility="{Binding HasAutostartNote, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <Button Content="{loc:T common_save}"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" />

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
