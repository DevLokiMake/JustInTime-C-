<UserControl x:Class="JustInTime.App.Views.TaskEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:JustInTime.App.Localization">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.25" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Левая колонка не шире 760, правая забирает остаток: форма прижата влево и сжимается вместе с окном -->
        <Grid Margin="32,28,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="760" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" Margin="0,0,0,20" />

                <!-- Ошибки -->
                <Border Style="{StaticResource Banner}"
                        Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Errors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{StaticResource DangerBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>

                        <TextBlock Text="{loc:T edit_title}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200" />

                        <TextBlock Text="{loc:T edit_action_type}" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource ChipList}"
                                 ItemsSource="{Binding ActionOptions}"
                                 SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                 DisplayMemberPath="Title"
                                 IsEnabled="{Binding CanChangeAction}" />

                        <!-- Отправка сообщения -->
                        <StackPanel Visibility="{Binding IsMessageAction, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T edit_messenger}" Style="{StaticResource FieldLabel}" />
                            <ListBox Style="{StaticResource ChipList}"
                                     ItemsSource="{Binding AppOptions}"
                                     SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                                     DisplayMemberPath="Title" />

                            <TextBlock Text="{loc:T edit_recipient}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Recipient, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="200" />

                            <TextBlock Text="{loc:T edit_message_text}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="96"
                                     MaxLength="4000"
                                     VerticalScrollBarVisibility="Auto" />

                            <Button Content="{loc:T edit_text_from_photo}"
                                    Command="{Binding OpenImageToTextCommand}"
                                    Style="{StaticResource SmallButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- Системная настройка -->
                        <StackPanel Visibility="{Binding IsSystemAction, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T edit_setting}" Style="{StaticResource FieldLabel}" />
                            <ListBox Style="{StaticResource ChipList}"
                                     ItemsSource="{Binding SettingOptions}"
                                     SelectedItem="{Binding SelectedSetting, Mode=TwoWay}"
                                     DisplayMemberPath="Title" />

                            <TextBlock Text="{loc:T edit_setting_action}" Style="{StaticResource FieldLabel}" />
                            <ListBox Style="{StaticResource ChipList}"
                                     ItemsSource="{Binding SwitchOptions}"
                                     SelectedItem="{Binding SelectedSwitch, Mode=TwoWay}"
                                     DisplayMemberPath="Title" />
                        </StackPanel>

                        <!-- Запуск программы -->
                        <StackPanel Visibility="{Binding IsProgramAction, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T edit_program_path}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ProgramPath, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="1000" />

                            <TextBlock Text="{loc:T edit_program_args}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ProgramArguments, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="2000" />
                        </StackPanel>

                        <!-- Открытие ссылки -->
                        <StackPanel Visibility="{Binding IsUrlAction, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T edit_url}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="2000" />
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Время -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:T edit_when_title}" Style="{StaticResource H2}" />

                        <ListBox Style="{StaticResource ChipList}"
                                 Margin="0,14,0,0"
                                 ItemsSource="{Binding ModeOptions}"
                                 SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                 DisplayMemberPath="Title" />

                        <StackPanel Visibility="{Binding IsDelayMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T edit_after_minutes}" Style="{StaticResource FieldLabel}" Margin="0,6,0,6" />
                            <TextBox Text="{Binding DelayMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="140"
                                     HorizontalAlignment="Left"
                                     MaxLength="7" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsAtTimeMode, Converter={StaticResource BoolToVis}}">
                            <WrapPanel Margin="0,6,0,0">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{loc:T edit_date}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="160"
                                             MaxLength="10" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{loc:T edit_time}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="110"
                                             MaxLength="5" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{Binding TimeZoneText}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Повтор -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:T edit_repeat_title}" Style="{StaticResource H2}" />
                        <TextBlock Text="{loc:T edit_repeat_hint}"
                                   Style="{StaticResource Muted}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <ListBox Style="{StaticResource ChipList}"
                                 Margin="0,14,0,0"
                                 ItemsSource="{Binding RepeatOptions}"
                                 SelectedItem="{Binding SelectedRepeat, Mode=TwoWay}"
                                 DisplayMemberPath="Title" />

                        <StackPanel Visibility="{Binding ShowEvery, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding EveryLabel}" Style="{StaticResource FieldLabel}" Margin="0,6,0,6" />
                            <TextBox Text="{Binding RepeatEveryText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="140"
                                     HorizontalAlignment="Left"
                                     MaxLength="6" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowWeekdays, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T edit_weekdays}" Style="{StaticResource FieldLabel}" Margin="0,6,0,6" />
                            <ItemsControl ItemsSource="{Binding Weekdays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Foreground="{StaticResource TextBrush}"
                                                  Margin="0,0,16,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowDayOfMonth, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T edit_month_day}"
                                       Style="{StaticResource FieldLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,6" />
                            <TextBox Text="{Binding DayOfMonthText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="110"
                                     HorizontalAlignment="Left"
                                     MaxLength="2" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="{Binding SaveButtonText}"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0" />
                    <Button Content="{loc:T common_cancel}"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
